rules_version = '2';

// Aftkad - افتقاد
// All data (children's names, phones, addresses, attendance, visit log)
// is private to the servants. No public access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
